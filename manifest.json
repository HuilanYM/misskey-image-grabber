{
  "manifest_version": 3,
  "name": "Misskey Image Grabber",
  "short_name": "MK Grabber",
  "version": "0.4.0",
  "description": "抓取 misskey.io / baraag.net 用户的推文与图片，生成可离线浏览的 HTML 档案（时间线 + 正文 + 图片）",
  "permissions": ["downloads", "storage", "unlimitedStorage", "tabs"],
  "host_permissions": [
    "https://misskey.io/*",
    "https://*.misskeyusercontent.jp/*",
    "https://baraag.net/*",
    "https://media.baraag.net/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://misskey.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": { "default_title": "打开 Misskey Image Grabber" }
}
